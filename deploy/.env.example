# ── GAOS cloud deployment environment variables ──────────────────
# Paste these into Railway → your service → Variables tab.
# (Local dev doesn't need any of these — config.json + token.json on disk win.)

# REQUIRED on Railway: the full contents of your config.json as one line.
# config.json is gitignored, so this is the ONLY way the server gets config.
#   PowerShell helper to produce the value:
#   Get-Content config.json -Raw | ForEach-Object { $_ -replace "`r`n","" }
GAOS_CONFIG_JSON={"business":{"name":"..."},"deepseek":{"api_key":"..."},...}

# REQUIRED for Gmail features on Railway: contents of a token.json that you
# generated LOCALLY (run any module once on your PC to create it).
GAOS_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"..."}

# OPTIONAL: Google service-account key for Sheets (preferred over OAuth token).
GAOS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# REQUIRED on Railway: prevents any attempt at interactive browser OAuth.
GAOS_HEADLESS=1

# RECOMMENDED: reject forged Twilio webhooks (needs twilio.auth_token in config).
GAOS_VALIDATE_TWILIO=1

# OPTIONAL: lock the chatbot widget to specific client sites.
# Default "*" lets the widget work from any website.
# GAOS_ALLOWED_ORIGINS=https://client-one.co.uk,https://client-two.co.uk

# OPTIONAL: Twilio auth token fallback for webhook signature validation
# (used when twilio.auth_token isn't present in the JSON config).
# TWILIO_AUTH_TOKEN=...

# Injected automatically by Railway/Heroku — only set locally if you want
# the server on a non-default port (local default is 8080).
# PORT=8080

# Individual key overrides also work (highest precedence):
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
