[Unit]
Description=GAOS™ v3.4 — Web Server (chatbot, WhatsApp, voice)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/gaos
Environment=GAOS_HEADLESS=1
Environment=PORT=8080
ExecStart=/usr/bin/python3 -m gunicorn gaos_server:app --bind 0.0.0.0:8080 --workers 1 --timeout 120
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
